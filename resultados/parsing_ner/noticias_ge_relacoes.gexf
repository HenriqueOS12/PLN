      <edge source="Ofício de outubro de 2025" target="inaceitáveis condições de limpeza que o Estádio estava sendo entregue para a realização dos jogos" id="12713">
        <attvalues>
          <attvalue for="0" value="apontar" />
          <attvalue for="1" value="Governo multa concessionária por gestão do Maracanã; Fla-Flu recorre" />
          <attvalue for="2" value="https://ge.globo.com/futebol/times/fluminense/noticia/2026/09/10/governo-multa-concessionaria-por-gestao-do-maracana-fla-flu-recorre.ghtml" />
          <attvalue for="3" value="Ofício de outubro de 2025, assinado pelos membros do comitê de fiscalização Luis Felipe Monteiro de Barros — hoje diretor do Maracanã — e Fernando Cunha, apontou que “durante as reuniões de trabalho realizadas nos dias 18/09 e 23/09, a equipe do CFGO (sigla da comissão fiscalizadora do contrato de concessão), advertiu a Fla-Flu Serviços SA., sobre as inaceitáveis condições de limpeza que o Estádio estava sendo entregue para a realização dos jogos ”." />
          <attvalue for="4" value="0" />
        </attvalues>
      </edge>
