      <edge source="Coritiba" target="um momento de oscilação" id="5585">
        <attvalues>
          <attvalue for="0" value="enfrentar" />
          <attvalue for="1" value="Athletiba: o que mudou para Coritiba e Athletico desde o clássico do primeiro turno da Série A" />
          <attvalue for="2" value="https://ge.globo.com/pr/futebol/brasileirao-serie-a/noticia/2026/09/10/athletiba-o-que-mudou-para-coritiba-e-athletico-desde-o-classico-do-primeiro-turno-da-serie-a.ghtml" />
          <attvalue for="3" value="Depois do clássico, o Coritiba enfrentou um momento de oscilação e venceu apenas uma vez em 10 jogos, somando dois contra o Santos, pela Copa do Brasil (acabou eliminado na quinta fase)." />
          <attvalue for="4" value="0" />
        </attvalues>
      </edge>
