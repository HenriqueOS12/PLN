      <edge source="nós" target="ideia de futebol" id="7392">
        <attvalues>
          <attvalue for="0" value="expresse" />
          <attvalue for="1" value="Da falência na 4ª divisão da Itália ao luxo na Champions: entenda o projeto que transformou o Como" />
          <attvalue for="2" value="https://ge.globo.com/futebol/futebol-internacional/liga-dos-campeoes/noticia/2026/09/10/da-falencia-na-4a-divisao-da-italia-ao-luxo-na-champions-entenda-o-projeto-que-transformou-o-como.ghtml" />
