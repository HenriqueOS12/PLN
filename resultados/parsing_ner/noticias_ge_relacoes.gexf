          <attvalue for="2" value="https://ge.globo.com/futebol/times/sao-paulo/noticia/2026/09/05/dorival-diz-que-sao-paulo-fez-o-melhor-jogo-sob-seu-comando-e-exalta-torcida-impressionante.ghtml" />
          <attvalue for="3" value="Eles acreditaram no momento mais complicado e difícil da competição, nos mostraram um caminho importante." />
          <attvalue for="4" value="0" />
        </attvalues>
      </edge>
