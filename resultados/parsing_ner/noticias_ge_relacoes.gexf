      <edge source="Abel" target="tudo" id="9044">
        <attvalues>
          <attvalue for="0" value="dever" />
          <attvalue for="1" value="Mais desfalques e menos opções? Como Palmeiras chega às quartas de final da Libertadores" />
          <attvalue for="2" value="https://ge.globo.com/futebol/times/palmeiras/noticia/2026/09/09/mais-desfalques-e-menos-opcoes-como-palmeiras-chega-as-quartas-de-final-da-libertadores.ghtml" />
          <attvalue for="3" value="Abel deve tudo ao Palmeiras, não o Palmeiras deve tudo ao Abel&quot;, diz Felipe Melo Prestes a reencontrar a LDU para as quartas de final da Libertadores, o Palmeiras vai a campo às 19h desta quarta-feira, no Nubank Parque, precisando criar vantagem na ida, sob pressão por causa da perda recente da liderança do Brasileiro e lidando com desfalques." />
          <attvalue for="4" value="0" />
        </attvalues>
      </edge>
      <edge source="Abel" target="2026 um elenco mais qualificado" id="9045">
        <attvalues>
          <attvalue for="0" value="ter" />
          <attvalue for="1" value="Mais desfalques e menos opções? Como Palmeiras chega às quartas de final da Libertadores" />
          <attvalue for="2" value="https://ge.globo.com/futebol/times/palmeiras/noticia/2026/09/09/mais-desfalques-e-menos-opcoes-como-palmeiras-chega-as-quartas-de-final-da-libertadores.ghtml" />
          <attvalue for="3" value="Ainda assim, Abel tem em 2026 um elenco mais qualificado, considerando, por exemplo, Arias e Marlon Freitas à disposição, ainda que tenha perdido Allan (que naquele momento ainda não estava em sua melhor versão) para o Manchester City." />
          <attvalue for="4" value="0" />
        </attvalues>
      </edge>
