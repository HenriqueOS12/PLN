      </edge>
      <edge source="nós" target="isso" id="7393">
        <attvalues>
          <attvalue for="0" value="trabalhar_por" />
          <attvalue for="1" value="Pedro Emanuel lamenta chances desperdiçadas pelo Vasco e indica Brasileirão como prioridade" />
