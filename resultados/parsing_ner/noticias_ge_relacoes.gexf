          <attvalue for="1" value="Investigado pela Polícia, Julio Casares é expulso do São Paulo" />
          <attvalue for="2" value="https://ge.globo.com/futebol/times/sao-paulo/noticia/2026/09/10/investigado-pela-policia-julio-casares-e-expulso-do-sao-paulo.ghtml" />
          <attvalue for="3" value="A decisão foi baseada em investigações internas que apontaram gestão temerária ou irregular de Julio Casares, presidente do São Paulo de 2021 a janeiro de 2026." />
