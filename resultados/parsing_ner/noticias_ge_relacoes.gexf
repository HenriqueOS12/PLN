          <attvalue for="2" value="https://ge.globo.com/pr/futebol/brasileirao-serie-a/noticia/2026/09/10/athletiba-o-que-mudou-para-coritiba-e-athletico-desde-o-classico-do-primeiro-turno-da-serie-a.ghtml" />
          <attvalue for="3" value="No primeiro turno, o Coritiba encarou o Athletico com Pedro Rangel; JP Chermont, Maicon, Jacy e Bruno Melo (Felipe Jonatan); Wallisson (Vini Paulista), Sebas Gómez e Josué; Lucas Ronier (Fabinho), Pedro Rocha (Keno) e Breno Lopes (Lavega)." />
          <attvalue for="4" value="0" />
        </attvalues>
      </edge>
