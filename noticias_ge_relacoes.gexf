          <attvalue for="0" value="fazer_entre" />
          <attvalue for="1" value="Presidente do Avaí fala sobre últimos dias do mercado aberto e explica trâmites da SAF" />
          <attvalue for="2" value="https://ge.globo.com/sc/futebol/times/avai/noticia/2026/09/10/presidente-do-avai-fala-sobre-ultimos-dias-do-mercado-aberto-e-explica-tramites-da-saf.ghtml" />
          <attvalue for="3" value="Dentro do clube, todo diálogo tem sido feito entre a diretoria e os atletas e funcionários e estão todos cientes das nossas responsabilidades." />
          <attvalue for="4" value="0" />
        </attvalues>
      </edge>
      <edge source="nós vamos conseguir sair dessa" target="apelo para que todos que estejam envolvidos no dia a dia, na comunidade do Avaí, percebam que as próximas 11 rodadas são rodadas que o Avaí precisa de união e ajuda, e somente na união de todos, especialmente a torcida do Avaí" id="1674">
        <attvalues>
          <attvalue for="0" value="faço" />
          <attvalue for="1" value="Presidente do Avaí fala sobre últimos dias do mercado aberto e explica trâmites da SAF" />
          <attvalue for="2" value="https://ge.globo.com/sc/futebol/times/avai/noticia/2026/09/10/presidente-do-avai-fala-sobre-ultimos-dias-do-mercado-aberto-e-explica-tramites-da-saf.ghtml" />
          <attvalue for="3" value="Faço um apelo para que todos que estejam envolvidos no dia a dia, na comunidade do Avaí, percebam que as próximas 11 rodadas são rodadas que o Avaí precisa de união e ajuda, e somente na união de todos, especialmente a torcida do Avaí, nós vamos conseguir sair dessa." />
          <attvalue for="4" value="0" />
        </attvalues>
      </edge>
