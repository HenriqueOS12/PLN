      <edge source="gente" target="que" id="272">
        <attvalues>
          <attvalue for="0" value="conseguir" />
          <attvalue for="1" value="Bragantino goleia Cruzeiro por 8 a 1 pelo Brasileirão Sub-17" />
          <attvalue for="2" value="https://ge.globo.com/sp/vale-do-paraiba-regiao/futebol/times/bragantino/noticia/2026/09/09/bragantino-goleia-cruzeiro-por-8-a-1-pelo-brasileirao-sub-17.ghtml" />
          <attvalue for="3" value="- Eu conheço bastante os jogadores do Cruzeiro e conheço bastante o clube, tem um grande trabalho, tem um grande treinador, então isso enaltece ainda mais a nossa vitória no dia de hoje e o que a gente conseguiu colocar em campo é a nossa identidade do jogo." />
          <attvalue for="4" value="1" />
