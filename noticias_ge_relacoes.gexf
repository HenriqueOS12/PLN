      <edge source="desembargador Anemar Pereira Amaral" target="processo" id="2240">
        <attvalues>
          <attvalue for="0" value="considerar_em" />
          <attvalue for="1" value="Justiça condena Cruzeiro a indenizar jogadora após grave lesão; entenda o caso" />
          <attvalue for="2" value="https://ge.globo.com/futebol/times/cruzeiro/noticia/2026/09/09/justica-condena-cruzeiro-a-indenizar-jogadora-apos-grave-lesao-entenda-o-caso.ghtml" />
          <attvalue for="3" value="No processo, o desembargador Anemar Pereira Amaral considerou que o Cruzeiro deveria ter mantido o vínculo com a atleta até 14 de fevereiro de 2026, garantindo o período de estabilidade após a recuperação." />
          <attvalue for="4" value="0" />
        </attvalues>
      </edge>
      <edge source="relator do caso" target="argumento" id="2241">
        <attvalues>
          <attvalue for="0" value="entender_apesar" />
          <attvalue for="1" value="Justiça condena Cruzeiro a indenizar jogadora após grave lesão; entenda o caso" />
          <attvalue for="2" value="https://ge.globo.com/futebol/times/cruzeiro/noticia/2026/09/09/justica-condena-cruzeiro-a-indenizar-jogadora-apos-grave-lesao-entenda-o-caso.ghtml" />
          <attvalue for="3" value="Apesar do argumento, o relator do caso entendeu que a lesão foi caracterizada como acidente de trabalho e que, por isso, o recebimento de benefício previdenciário não seria necessário para assegurar a estabilidade." />
          <attvalue for="4" value="0" />
        </attvalues>
      </edge>
      <edge source="desembargador" target="Cruzeiro" id="2242">
        <attvalues>
          <attvalue for="0" value="condenar" />
          <attvalue for="1" value="Justiça condena Cruzeiro a indenizar jogadora após grave lesão; entenda o caso" />
