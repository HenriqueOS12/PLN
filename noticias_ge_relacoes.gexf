      <edge source="que" target="clube de 2021 a 2026" id="236">
        <attvalues>
          <attvalue for="0" value="dirigir" />
          <attvalue for="1" value="Do impeachment à votação pela expulsão: a crise que levou Casares a novo julgamento no São Paulo" />
          <attvalue for="2" value="https://ge.globo.com/futebol/times/sao-paulo/noticia/2026/09/10/do-impeachment-a-votacao-pela-expulsao-a-crise-que-levou-casares-a-novo-julgamento-no-sao-paulo.ghtml" />
          <attvalue for="3" value="O documento, elaborado no último dia 24, aponta gestão temerária de Julio Casares, que dirigiu o clube de 2021 a 2026, até sofrer impeachment e renunciar ao cargo antes da decisão final em Assembleia Geral." />
          <attvalue for="4" value="0" />
        </attvalues>
      </edge>
      <edge source="que" target="processo judicial" id="237">
        <attvalues>
          <attvalue for="0" value="condenar_em" />
          <attvalue for="1" value="Do impeachment à votação pela expulsão: a crise que levou Casares a novo julgamento no São Paulo" />
          <attvalue for="2" value="https://ge.globo.com/futebol/times/sao-paulo/noticia/2026/09/10/do-impeachment-a-votacao-pela-expulsao-a-crise-que-levou-casares-a-novo-julgamento-no-sao-paulo.ghtml" />
          <attvalue for="3" value="— Estará sujeito à pena de eliminação do quadro associativo do SPFC o associado que for condenado em processo judicial, definitivamente, ou venha a ser responsabilizado disciplinarmente, pela prática de ato de gestão irregular ou temerária, na forma da legislação vigente, em especial o disposto no art. 25 da Lei nº 13.155, de 04 de agosto de 2015, ou naquele que vier a substituí-lo — diz o documento." />
          <attvalue for="4" value="0" />
        </attvalues>
      </edge>
      <edge source="que" target="cargo diretivo" id="238">
        <attvalues>
          <attvalue for="0" value="ter" />
          <attvalue for="1" value="Do impeachment à votação pela expulsão: a crise que levou Casares a novo julgamento no São Paulo" />
          <attvalue for="2" value="https://ge.globo.com/futebol/times/sao-paulo/noticia/2026/09/10/do-impeachment-a-votacao-pela-expulsao-a-crise-que-levou-casares-a-novo-julgamento-no-sao-paulo.ghtml" />
          <attvalue for="3" value="A derrocada de Casares começou em dezembro do ano passado, depois de o ge revela esquema ilegal de camarote pertencente à diretoria em dias de shows no Morumbis , com participação de Douglas Schwartzmann, braço-direito de Casares e ex-diretor adjunto de futebol de base, e Mara Casares, ex-esposa do dirigente que também tinha um cargo diretivo." />
          <attvalue for="4" value="0" />
        </attvalues>
      </edge>
      <edge source="que" target="R$" id="239">
        <attvalues>
          <attvalue for="0" value="totalizar" />
          <attvalue for="1" value="Do impeachment à votação pela expulsão: a crise que levou Casares a novo julgamento no São Paulo" />
          <attvalue for="2" value="https://ge.globo.com/futebol/times/sao-paulo/noticia/2026/09/10/do-impeachment-a-votacao-pela-expulsao-a-crise-que-levou-casares-a-novo-julgamento-no-sao-paulo.ghtml" />
          <attvalue for="3" value="O motivo foi a detecção de saques suspeitos feitos por Julio Casares que totalizavam R$ 7 milhões, sem documentação ou justificativa." />
          <attvalue for="4" value="0" />
