      <edge source="Comissão de Fiscalização" target="ofício que mantinha integralmente a manifestação do Verificador Independente pela “continuidade de falhas e de embaraço à atividade de verificação" id="1029">
        <attvalues>
          <attvalue for="0" value="assinalar_por" />
          <attvalue for="1" value="Governo multa concessionária por gestão do Maracanã; Fla-Flu recorre" />
          <attvalue for="2" value="https://ge.globo.com/futebol/times/fluminense/noticia/2026/09/10/governo-multa-concessionaria-por-gestao-do-maracana-fla-flu-recorre.ghtml" />
          <attvalue for="3" value="A Comissão de Fiscalização do contrato do Maracanã, em abril deste ano, assinalou por ofício que mantinha integralmente a manifestação do Verificador Independente pela “continuidade de falhas e de embaraço à atividade de verificação” e também pela “não conformidade da Concessionária quanto às obrigações de planejamento, execução e comprovação documental”." />
          <attvalue for="4" value="0" />
        </attvalues>
      </edge>
      <edge source="Comissão de Fiscalização" target="ano" id="1030">
        <attvalues>
          <attvalue for="0" value="enviar_em este" />
          <attvalue for="1" value="Governo multa concessionária por gestão do Maracanã; Fla-Flu recorre" />
          <attvalue for="2" value="https://ge.globo.com/futebol/times/fluminense/noticia/2026/09/10/governo-multa-concessionaria-por-gestao-do-maracana-fla-flu-recorre.ghtml" />
          <attvalue for="3" value="Neste ano, no início de setembro, a Comissão de Fiscalização, Gestão e Operação do Maracanã enviou novo ofício para falar de manutenção dos assentos na Tribuna de Honra do estádio, que vão passar por reforma para a Copa do Mundo de 2027." />
          <attvalue for="4" value="0" />
        </attvalues>
      </edge>
