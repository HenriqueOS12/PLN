      <edge source="aqueles que amam o clube, que tratam o clube como seu produto" target="imprensa" id="1672">
        <attvalues>
          <attvalue for="0" value="valer_pra" />
          <attvalue for="1" value="Presidente do Avaí fala sobre últimos dias do mercado aberto e explica trâmites da SAF" />
          <attvalue for="2" value="https://ge.globo.com/sc/futebol/times/avai/noticia/2026/09/10/presidente-do-avai-fala-sobre-ultimos-dias-do-mercado-aberto-e-explica-tramites-da-saf.ghtml" />
          <attvalue for="3" value="Precisamos entender que todos aqueles que amam o clube, que tratam o clube como seu produto, isso vale pra imprensa, canais que cobrem o Avaí, que nós precisamos ter uma concepção geral de união." />
          <attvalue for="4" value="0" />
        </attvalues>
      </edge>
      <edge source="diálogo" target="diretoria e os atletas e funcionários" id="1673">
