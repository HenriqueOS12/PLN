          <attvalue for="3" value="Casares devolveu R$ 560.401,74 ao São Paulo em novembro do ano passado, quando já era investigado pela Polícia Civil por possíveis irregularidades em sua gestão." />
          <attvalue for="4" value="0" />
        </attvalues>
      </edge>
      <edge source="Casares" target="novembro do ano passado" id="1504">
        <attvalues>
          <attvalue for="0" value="devolver_em" />
          <attvalue for="1" value="Do impeachment à votação pela expulsão: a crise que levou Casares a novo julgamento no São Paulo" />
          <attvalue for="2" value="https://ge.globo.com/futebol/times/sao-paulo/noticia/2026/09/10/do-impeachment-a-votacao-pela-expulsao-a-crise-que-levou-casares-a-novo-julgamento-no-sao-paulo.ghtml" />
          <attvalue for="3" value="Casares devolveu R$ 560.401,74 ao São Paulo em novembro do ano passado, quando já era investigado pela Polícia Civil por possíveis irregularidades em sua gestão." />
          <attvalue for="4" value="1" />
        </attvalues>
      </edge>
      <edge source="Casares" target="base no Artigo 11 do Estatuto Social" id="1505">
        <attvalues>
          <attvalue for="0" value="indenizar_com" />
          <attvalue for="1" value="Investigado pela Polícia, Julio Casares é expulso do São Paulo" />
          <attvalue for="2" value="https://ge.globo.com/futebol/times/sao-paulo/noticia/2026/09/10/investigado-pela-policia-julio-casares-e-expulso-do-sao-paulo.ghtml" />
          <attvalue for="3" value="A Comissão de Ética recomendou que Casares indenize o São Paulo com base no Artigo 11 do Estatuto Social, que diz que a penalidade de indenização “é aplicável ao associado que (...) causar dano ou prejuízo material ao clube”." />
          <attvalue for="4" value="0" />
        </attvalues>
      </edge>
      <edge source="pedido de demissão do quadro associativo do São Paulo" target="procedimento administrativo disciplinar" id="1506">
        <attvalues>
          <attvalue for="0" value="aceitar_durante" />
          <attvalue for="1" value="Investigado pela Polícia, Julio Casares é expulso do São Paulo" />
          <attvalue for="2" value="https://ge.globo.com/futebol/times/sao-paulo/noticia/2026/09/10/investigado-pela-policia-julio-casares-e-expulso-do-sao-paulo.ghtml" />
          <attvalue for="3" value="O relatório aprovado pelo Conselho explica também por que o pedido de encerramento do processo não foi aceito, usando como base o Artigo 38 do Estatuto Social do clube, que determina que não será aceito o pedido de demissão do quadro associativo do São Paulo durante um procedimento administrativo disciplinar, até sua conclusão." />
          <attvalue for="4" value="0" />
        </attvalues>
      </edge>
